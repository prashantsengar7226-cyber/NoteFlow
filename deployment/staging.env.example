# Copy to .env.staging.local. Use NEW staging projects, never current credentials.
# Local-only staging runner starts on http://127.0.0.1:3200.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Start with Basic summaries. Add separate provider test credentials only later.
AI_PROVIDER=router
AI_PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
SUPADATA_API_KEY=

# This staging runner deliberately disables payments.
# Razorpay test-mode qualification is a separate release gate.
MONETIZATION_MODE=free_launch
BILLING_ENABLED=false
PRO_PRICE_PAISE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Personal AI staging: use fresh secrets; never copy production encryption/worker keys.
BYOK_ENCRYPTION_KEY=
QUEUE_WORKER_SECRET=
QUEUE_SCHEDULER_ENABLED=false
