# Server-only AI router. Never add NEXT_PUBLIC_ to these names.
AI_PROVIDER=router
AI_PROVIDER_ORDER=gemini,groq,openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
# OpenRouter's free router automatically selects an eligible free model.
OPENROUTER_MODEL=openrouter/free

SUPADATA_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase public project credentials, safe for the browser. NOT a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

MONETIZATION_MODE=free_launch
BILLING_ENABLED=false
PRO_PRICE_PAISE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
