# Server-only AI router. Never add NEXT_PUBLIC_ to these names.
AI_PROVIDER=router
AI_PROVIDER_ORDER=gemini,groq,openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
# OpenRouter's free router automatically selects an eligible free model.
OPENROUTER_MODEL=openrouter/free

SUPADATA_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase public project credentials, safe for the browser. NOT a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

MONETIZATION_MODE=free_launch
BILLING_ENABLED=false
PRO_PRICE_PAISE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Personal API keys: generate 32 random bytes, base64 encoded. Server-only.
# Keep this key stable; replacing it makes existing encrypted connections unreadable.
BYOK_ENCRYPTION_KEY=
# Generate a separate random secret. Put it in the scheduler Authorization header.
QUEUE_WORKER_SECRET=
# Set true only after a recurring POST to /api/queue-worker is configured.
QUEUE_SCHEDULER_ENABLED=false

# Enable only after migration 0004 and Vertex billing/credential verification.
# Free shared AI for regular users; paid Vertex summaries/insights for database-managed admins only.
# No user daily/weekly AI cap; provider limits and server abuse controls still apply.
AI_FEATURE_ROUTING=false
# Experimental larger summary batches; affects new jobs only. Keep disabled
# until full-source coverage and completion benchmarks pass for your model.
SUMMARY_LARGE_BATCHES=false
# Production: admins enables the trial only for database-confirmed admins and
# superusers; off disables it. Requires redeployment after changing this value.
SUMMARY_PIPELINE_TRIAL=off
# Deprecated: no longer grants access. Use migration 0005 and scripts/bootstrap-superuser.mjs.
AI_ADMIN_USER_IDS=
VERTEX_ENABLED=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Set a Gemini Flash model available in your Vertex project; no default paid model.
VERTEX_MODEL=
# Compact service-account JSON; server-only secret, never NEXT_PUBLIC_.
VERTEX_SERVICE_ACCOUNT_JSON=
# Local testing only; ignored on Vercel. Never upload personal gcloud credentials.
VERTEX_ALLOW_LOCAL_ADC=false
VERTEX_LOCAL_ADC_PATH=
# Stop BEFORE the credit expiry. ISO UTC timestamp; required.
VERTEX_CREDIT_EXPIRES_AT=
# Admins have no NoteFlow Vertex attempt cap. Attempts are metered in the dashboard.
# Legacy VERTEX_DAILY_REQUEST_CAP / VERTEX_TOTAL_REQUEST_CAP values are ignored.



# Shared regular-user AI: one Gemini model, no provider/model fallback.
# Use a separate AI Studio Free-tier project with billing disabled.
GEMINI_FREE_API_KEY=
GEMINI_FREE_MODEL=gemini-3.6-flash
GEMINI_FREE_TIER_CONFIRMED=false

# Optional actual Vertex billing: standard usage-cost export to BigQuery.
# See VERTEX-COSTS.md for least-privilege roles and export setup.
CLOUD_BILLING_EXPORT_TABLE=
CLOUD_BILLING_EXPORT_LOCATION=
# Optional dedicated read/query service account; otherwise Vertex identity is used.
CLOUD_BILLING_SERVICE_ACCOUNT_JSON=
