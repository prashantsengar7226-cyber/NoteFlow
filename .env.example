# Server-only AI router. Never add NEXT_PUBLIC_ to these names.
AI_PROVIDER=router
AI_PROVIDER_ORDER=gemini,groq,openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
# OpenRouter's free router automatically selects an eligible free model.
OPENROUTER_MODEL=openrouter/free

SUPADATA_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase public project credentials, safe for the browser. NOT a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

MONETIZATION_MODE=free_launch
BILLING_ENABLED=false
PRO_PRICE_PAISE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Personal API keys: generate 32 random bytes, base64 encoded. Server-only.
# Keep this key stable; replacing it makes existing encrypted connections unreadable.
BYOK_ENCRYPTION_KEY=
# Generate a separate random secret. Put it in the scheduler Authorization header.
QUEUE_WORKER_SECRET=
# Set true only after a recurring POST to /api/queue-worker is configured.
QUEUE_SCHEDULER_ENABLED=false

# Enable only after migration 0004 and Vertex billing/credential verification.
# Free shared AI for regular users; paid Vertex summaries/insights for allowlisted admins only.
# No user daily/weekly AI cap; provider limits and server abuse controls still apply.
AI_FEATURE_ROUTING=false
# Comma-separated Supabase Auth UUIDs. Never derive admin from client metadata.
AI_ADMIN_USER_IDS=
VERTEX_ENABLED=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Set a Gemini Flash model available in your Vertex project; no default paid model.
VERTEX_MODEL=
# Compact service-account JSON; server-only secret, never NEXT_PUBLIC_.
VERTEX_SERVICE_ACCOUNT_JSON=
# Local testing only; ignored on Vercel. Never upload personal gcloud credentials.
VERTEX_ALLOW_LOCAL_ADC=false
VERTEX_LOCAL_ADC_PATH=
# Stop BEFORE the credit expiry. ISO UTC timestamp; required.
VERTEX_CREDIT_EXPIRES_AT=
# All generation/review attempts, across users AND admins. Required positive integers.
VERTEX_DAILY_REQUEST_CAP=100
VERTEX_TOTAL_REQUEST_CAP=1000
